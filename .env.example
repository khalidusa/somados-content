# انسخه إلى .env واملأه. لا ترفع .env إلى المستودع (مُستثنى بـ.gitignore).
# نفس الأسماء تُوضع بـ GitHub Secrets للتشغيل الآلي.

# Cloudflare Workers AI — dash.cloudflare.com ← AI ← Workers AI ← Use REST API
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Buffer — publish.buffer.com/settings/api ← New Key (صلاحية سنة)
BUFFER_ACCESS_TOKEN=

# اختياري: التعليق الأول يحتاج خطة مدفوعة — اتركه فارغاً بالخطة المجانية
BUFFER_FIRST_COMMENT=

# اختياري: true يصرّح لميتا أن المحتوى مولّد بالذكاء الاصطناعي.
# اتركه فارغاً لعدم التصريح — لا تضع false، إرسال false تصريح كاذب.
DECLARE_AI_GENERATED=

# رابط GitHub Pages الذي يستضيف الوسائط (ليس raw.githubusercontent — يرجع 429)
PAGES_BASE_URL=
